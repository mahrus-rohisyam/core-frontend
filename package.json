{
  "name": "core-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core-config",
    "packages/core-ui",
    "packages/core-api",
    "packages/core-auth",
    "packages/core-shell",
    "examples/app"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p examples/app && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "vite examples/app",
    "build:example": "vite build examples/app",
    "gen:api": "openapi-typescript ../core-backend/api/openapi.json -o packages/core-api/src/schema.ts",
    "check:unicode": "git ls-files -z | xargs -0 python3 -I scripts/agent/check-hidden-unicode.py",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
